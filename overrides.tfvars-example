# k8tre-infrastructure-gcp/
# terraform apply -var-file=overrides.tfvars

project_id = "my-gcp-project"
region     = "europe-west2"

allowed_cidrs = [
  "myip",
  "192.0.2.0/24",
]

dns_domain          = "k8tre-dev-gke.example.org"
request_certificate = "gcp"

additional_admin_principals = {
  additional-sa = "serviceAccount:admin@my-gcp-project.iam.gserviceaccount.com"
}

k8tre_cluster_label_overrides = {
  environment = "stg"
}

k8tre_github_repo = "manics/k8tre"
k8tre_github_ref  = "gcp-dev"

additional_k8s_manifests = [
#  "/path/to/additional/k8s-manifests.yaml"
]

